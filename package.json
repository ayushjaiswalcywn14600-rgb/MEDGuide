{
  "name": "medguide",
  "version": "0.1.0",
  "private": true,
  "description": "MEDGUIDE health-navigation and care-access platform",
  "workspaces": [
    "backend",
    "apps/web-app",
    "apps/admin-dashboard",
    "apps/mobile-app"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=apps/web-app",
    "dev:admin": "npm run dev --workspace=apps/admin-dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "license": "UNLICENSED"
}
