# ---------- General ----------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=medguide
POSTGRES_PASSWORD=medguide_dev_secret_password_change_in_prod
POSTGRES_DB=medguide
DATABASE_URL=postgresql://medguide:medguide_dev_secret_password_change_in_prod@localhost:5432/medguide

# ---------- Cache & Session (Redis) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Minimum 32 characters required by startup validation
JWT_SECRET=medguide_super_secure_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ---------- SMS Provider ----------
# console | msg91 | twilio
SMS_PROVIDER=console
OTP_PROVIDER_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- File Storage ----------
# s3 | minio | local
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=medguide-uploads
CLOUDINARY_URL=

# ---------- Real-time (Firebase) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Video Consultation ----------
# agora | twilio | mock
VIDEO_PROVIDER=mock
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---------- Maps & Facility Discovery ----------
GOOGLE_MAPS_API_KEY=

# ---------- AI Microservice ----------
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=medguide_ai_secret_key_32_chars_long_dev

# ---------- ABDM Health Facility Registry ----------
ABDM_HFR_BASE_URL=https://facility.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---------- Notifications ----------
FCM_SERVER_KEY=

# ---------- Emergency Protocols (India) ----------
AMBULANCE_DISPATCH_API_KEY=
NATIONAL_EMERGENCY_NUMBER=112
NATIONAL_AMBULANCE_NUMBER=108
TELE_MANAS_HELPLINE=14416
TELE_MANAS_TOLL_FREE=1-800-891-4416
